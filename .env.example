# Azure OpenAI Foundry v1 endpoint (Entra ID auth, no keys)
AZURE_OPENAI_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Deployment names (referenced in API calls as `model` field)
AZURE_OPENAI_DEPLOYMENT_GPT_4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_GPT_5_2=gpt-5.2

# Task 013 Phase 2 dual-endpoint spillover measurement primary deployment.
# A gpt-5.2-family GlobalStandard PAYG deployment provisioned at a deliberately
# low TPM cap so the ~30K-input-token sustained workload produces real 429s on
# the primary route. The spillover route reuses AZURE_OPENAI_DEPLOYMENT_GPT_5_2
# (500K TPM, unchanged from benchmark 01).
AZURE_OPENAI_DEPLOYMENT_GPT_5_2_THROTTLED=ptu-deploy-throttled

# Authentication mode (entra | apikey) — this repo uses entra exclusively
AZURE_AUTH_MODE=entra

# Optional: region reference (not used in calls; for documentation)
AZURE_REGION=eastus2

# Budget guards
MAX_COST_PER_BENCHMARK_USD=100
MAX_TOTAL_COST_USD=500
