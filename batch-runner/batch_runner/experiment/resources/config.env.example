# Environment variables for the five-minute sample. Copy to `.env` and fill in
# real values locally. This file records NAMES only — never paste secrets here
# and never commit a filled-in copy.

# --- Ollama (local, no cloud cost) ---
# Base URL of your local Ollama server. Default works out of the box.
OLLAMA_BASE_URL=http://localhost:11434

# --- Azure OpenAI in Microsoft Foundry (billed) ---
# Your Foundry endpoint, e.g. https://<resource>.openai.azure.com (no trailing
# path). The runner appends /openai/v1/ itself. Never commit the real value.
AZURE_OPENAI_FOUNDRY_ENDPOINT=

# Optional: authentication mode hint read by the Azure runners.
# Leave unset to use DefaultAzureCredential (recommended: `az login`).
# AZURE_AUTH_MODE=
