{
  "schema_version": "1.1.0",
  "scope": "installed reasoning-payoff CLI",
  "python_support": {
    "implementation": "CPython",
    "minimum": "3.11",
    "maximum_exclusive": "3.14",
    "ci_endpoints": ["3.11", "3.13"]
  },
  "platform_support": {
    "minimal_core": {
      "operating_systems": ["Linux", "macOS", "Windows"],
      "non_editable_wheel_ci": true,
      "provider_network_in_ci": false
    },
    "full_research_campaign": {
      "reference": "Linux x86-64 / CPython 3.11",
      "macos": "operator-supported with platform-specific dependency resolution",
      "windows": "unsupported; use WSL/Linux",
      "posix_dependencies": [
        "Bash/POSIX campaign and release commands",
        "fcntl in scripts/measure_max_output_tokens_sweep.py",
        "SHA-256 shell utilities in validation workflows"
      ]
    }
  },
  "reproducibility_contracts": [
    {
      "id": "cold-mock",
      "threshold_seconds": 300,
      "enforcement": "github-actions-ubuntu-latest-py313",
      "network": "package index only; no provider"
    },
    {
      "id": "warm-ollama",
      "threshold_seconds": 300,
      "enforcement": "operator-timed after doctor warm readiness",
      "excluded": ["Ollama installation", "service startup", "model pull"]
    },
    {
      "id": "full-research-rerun",
      "threshold_seconds": null,
      "enforcement": "all planned cells terminal and all publication gates pass"
    }
  ],
  "automation_contracts": [
    {
      "id": "protected-azure-smoke",
      "entrypoint": "python -m scripts.run_protected_azure_smoke --live",
      "execution": "protected-live-provider",
      "network": "azure-https",
      "cost": "billed-under-hard-ceiling",
      "public_pr_ci": false,
      "offline_fake_in_pr_ci": true,
      "guards": [
        "main schedule or manual dispatch only",
        "protected GitHub environment",
        "Azure self-hosted runner with managed identity",
        "managed-identity-only DefaultAzureCredential chain",
        "one request, no retry, no stored input or output",
        "fresh immutable pricing and dual cost confirmation",
        "sanitized health-only artifact"
      ]
    }
  ],
  "commands": [
    {
      "id": "init",
      "cli_path": "reasoning-payoff init",
      "variant": "default",
      "execution": "offline",
      "network": "none",
      "cost": "none",
      "guards": [],
      "readme_row": [
        "`init`",
        "`reasoning-payoff init`",
        "Offline fixture copy",
        "No runtime network",
        "No provider cost"
      ]
    },
