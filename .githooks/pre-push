#!/usr/bin/env bash
#
# pre-push — catch public-release / docs gate failures locally, before CI.
#
# Mirrors the read-only, no-credentials gates that the CI workflow
# (.github/workflows/ci.yml) runs after the test suite. The most common
# failure this prevents is a *public manifest SHA drift*: when you edit a
# manifest-tracked public artifact (e.g. results/**, chart data, CSVs) the
# recorded `sanitized_sha256` in release/public_sanitized_manifest.json goes
# stale until the redaction sweep is re-run. See docs/16 §8.1 and the
# CONTRIBUTING "Pull request checklist".
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Bypass intentionally (not recommended):
#     git push --no-verify
#
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

fail=0

echo "== pre-push 1/7: protected historical trees =="
check_tree() {
  commit="$1"
  path="$2"
  expected="$3"
  actual="$(git rev-parse "$commit^{commit}:$path" 2>/dev/null)" || return 1
  if [ "$actual" != "$expected" ]; then
    printf 'pre-push: protected tree changed in %s: %s\n' "$commit" "$path" >&2
    return 1
  fi
}
outgoing=()
while read -r _local_ref local_oid _remote_ref _remote_oid; do
  case "$local_oid" in
    ""|0000000000000000000000000000000000000000) ;;
    *) outgoing+=("$local_oid") ;;
  esac
done
if [ "${#outgoing[@]}" -eq 0 ]; then
  outgoing=(HEAD)
fi
for commit in "${outgoing[@]}"; do
  check_tree "$commit" docs/blog e735fb80e200db942df15a49a14671edff0fa23a || fail=1
  check_tree "$commit" benchmarks 200e5b5c3cfe44a082691ad0ea15d97dc5593dd6 || fail=1
  check_tree "$commit" results 0687541fa1cefe71faefb182d29cfcaf1f0c6096 || fail=1
done

PY=""
for c in python3 python; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  echo "pre-push: no 'python3'/'python' on PATH — Python gates skipped." >&2
  if [ "$fail" -ne 0 ]; then exit 1; fi
  exit 0
fi

echo "== pre-push 2/7: claim integrity gate =="
if ! "$PY" scripts/check_claim_integrity.py check; then
  fail=1
fi

echo "== pre-push 3/7: schema meta-validation =="
if ! "$PY" scripts/check_schema_conformance.py schema-meta; then
  fail=1
fi

echo "== pre-push 4/7: committed artifact instance conformance =="
if ! "$PY" scripts/check_schema_conformance.py artifact-conformance; then
  fail=1
fi

echo "== pre-push 5/7: sanitizer release gate (public manifest integrity) =="
if ! "$PY" scripts/sanitize_public_artifacts.py --verify --require-public-manifest; then
  fail=1
  cat >&2 <<'EOF'

  ^ Public manifest drift or a forbidden token was detected.
    If you legitimately edited a manifest-tracked public artifact and it is
    still token-clean, re-pin its recorded hash from the public tree
    (no private archive needed):

        python scripts/sanitize_public_artifacts.py --refresh-hashes
        git add release/public_sanitized_manifest.json && git commit

    Use --apply instead (needs the private redaction archive) when adding a
    new artifact or if a forbidden token was reintroduced.
    (docs/16 §8.1 release-readiness gate; CONTRIBUTING "Pull request checklist".)
EOF
fi

echo "== pre-push 6/7: defensive public-surface grep =="
if [ -f scripts/check_public_surface.sh ]; then
  bash scripts/check_public_surface.sh || fail=1
else
  echo "pre-push: scripts/check_public_surface.sh not found — skipped." >&2
fi

echo "== pre-push 7/7: static Pages site validation =="
if [ -f docs/validate.sh ]; then
  bash docs/validate.sh || fail=1
else
  echo "pre-push: docs/validate.sh not found — skipped." >&2
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: one or more gates failed — push aborted." >&2
  echo "          Fix the above, or bypass deliberately with 'git push --no-verify'." >&2
  exit 1
fi

echo "pre-push: all release/docs gates green."
exit 0
