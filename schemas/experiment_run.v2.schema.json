{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hyeonsangjeon/when-reasoning-pays-off/schemas/experiment_run.v2.schema.json",
  "title": "ImmutableExperimentRun",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "ledger_schema_version",
    "run_id",
    "lineage",
    "status",
    "counts",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "ledger_schema_version": { "const": "1.0.0" },
    "run_id": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}Z_[0-9a-f]{8}_[0-9a-f]{8}_[0-9a-f]{8}$"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "parent_run_id"],
      "properties": {
        "kind": { "enum": ["initial", "retry_failed"] },
        "parent_run_id": { "type": ["string", "null"] }
      }
    },
    "status": { "enum": ["ok", "partial", "failed"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "ok", "error"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "ok": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "const": {
        "run_json": "run.json",
        "records_jsonl": "records.jsonl",
        "summary_md": "summary.md",
        "manifest_json": "manifest.json",
        "artifacts_sha256": "artifacts.sha256"
      }
    }
  }
}
