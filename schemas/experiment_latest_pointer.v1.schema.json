{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hyeonsangjeon/when-reasoning-pays-off/schemas/experiment_latest_pointer.v1.schema.json",
  "title": "LatestImmutableExperimentRunPointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_path", "status", "manifest_sha256"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}Z_[0-9a-f]{8}_[0-9a-f]{8}_[0-9a-f]{8}$"
    },
    "run_path": {
      "type": "string",
      "pattern": "^runs/\\d{8}T\\d{6}Z_[0-9a-f]{8}_[0-9a-f]{8}_[0-9a-f]{8}$"
    },
    "status": { "enum": ["ok", "partial", "failed"] },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
