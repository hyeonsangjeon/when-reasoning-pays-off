{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UsageEnvelopeV1",
  "description": "Strict operational metadata for offline reasoning analysis. Content and infrastructure identifiers are not accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "provider",
    "model",
    "reasoning_effort",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "reasoning_tokens",
    "latency_ms",
    "status_code",
    "retry_after_ms"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "const": "azure-openai"
    },
    "model": {
      "type": "string",
      "pattern": "^(?!.*(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3})(?![0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$)(?![A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,63}$)(?![0-9A-Fa-f]{32,}$)(?![A-Za-z0-9_+/=]{40,}$)[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "reasoning_effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "cached_input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "reasoning_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 604800000
    },
    "status_code": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "retry_after_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 604800000
    }
  }
}
